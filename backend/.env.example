# Copy to .env and fill in. The backend reads this via process.env (no dotenv
# dependency needed if you export these in your shell/CI/Docker environment).

PORT=4000

# Optional. The agent works fully offline by default (retrieves from the
# in-memory RAG store and synthesizes an answer directly from the results,
# no LLM call, no key needed). Set this only if you want the agent to
# upgrade to Anthropic-generated, more natural answers over the same
# grounded retrieval.
ANTHROPIC_API_KEY=

# --- Auth (see SECURITY.md) ---
# Secret used to sign/verify session JWTs. REQUIRED in production — the
# server refuses to start in production without one set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long an issued token is valid for.
JWT_EXPIRES_IN=15m

# Comma-separated tenantId:apiKey pairs. Each entry is one caller's
# credential; POST /api/auth/token exchanges a valid apiKey for a JWT
# carrying that tenantId, which is what scopes their validation history.
# Example (do not use in production):
#   API_KEYS=demo:sk_demo_replace_me,acme:sk_live_replace_me
API_KEYS=

# --- CORS ---
# Comma-separated list of origins allowed to call the API / connect over
# Socket.IO. Defaults to localhost dev origins if unset — set this
# explicitly in any deployed environment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Real-time (Socket.IO + Redis) ---
REDIS_URL=redis://localhost:6379

# --- Active domain ---
# Which rule engine validates incoming records (see backend/src/engines/).
#   product  — e-commerce product feed rules (default)
#   invoice  — accounting/invoice rules (invoice number, VAT rate, vendor, etc.)
# Switching this also changes what the RAG knowledge base and the agent talk
# about — run `node scripts/build-kb.js` again after changing it.
ACTIVE_ENGINE=product
