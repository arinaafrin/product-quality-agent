# Copy to .env and fill in. The backend reads this via process.env (no dotenv
# dependency needed if you export these in your shell/CI/Docker environment).

PORT=4000

# Optional. The agent works fully offline by default (retrieves from the
# in-memory RAG store and synthesizes an answer directly from the results,
# no LLM call, no key needed). Set this only if you want the agent to
# upgrade to Anthropic-generated, more natural answers over the same
# grounded retrieval.
ANTHROPIC_API_KEY=
