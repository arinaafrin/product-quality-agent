# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECURE_SSL_REDIRECT=True

# --- Database ---
DATABASE_URL=postgres://timecapsule:timecapsule@db:5432/timecapsule

# --- Cache / Celery (Redis) ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI providers ---
AI_STORY_PROVIDER=anthropic
AI_IMAGE_PROVIDER=stability
AI_GENERATION_RATE_LIMIT_PER_HOUR=10
ANTHROPIC_API_KEY=
STABILITY_API_KEY=

# --- Media ---
MEDIA_SIGNED_URL_TTL_SECONDS=900
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# --- Google OAuth / Maps ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_MAPS_API_KEY=

# --- Error tracking (production only) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

LOG_LEVEL=INFO
